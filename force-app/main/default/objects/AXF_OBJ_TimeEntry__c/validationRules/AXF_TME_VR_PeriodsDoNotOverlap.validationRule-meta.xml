<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AXF_TME_VR_PeriodsDoNotOverlap</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(AXF_TME_TIM_Out1__c)), NOT(ISBLANK(AXF_TME_TIM_In2__c)), AXF_TME_TIM_In2__c &lt; AXF_TME_TIM_Out1__c)</errorConditionFormula>
    <errorDisplayField>AXF_TME_TIM_In2__c</errorDisplayField>
    <errorMessage>Time In 2 cannot be before Time Out 1.</errorMessage>
</ValidationRule>
