<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AXF_TME_VR_FirstPeriodOrder</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(AXF_TME_TIM_In1__c)), NOT(ISBLANK(AXF_TME_TIM_Out1__c)), AXF_TME_TIM_Out1__c &lt;= AXF_TME_TIM_In1__c)</errorConditionFormula>
    <errorDisplayField>AXF_TME_TIM_Out1__c</errorDisplayField>
    <errorMessage>Time Out 1 must be after Time In 1.</errorMessage>
</ValidationRule>
