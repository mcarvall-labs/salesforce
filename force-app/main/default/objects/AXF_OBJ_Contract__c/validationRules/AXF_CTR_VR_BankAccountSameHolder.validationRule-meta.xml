<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AXF_CTR_VR_BankAccountSameHolder</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(AXF_CTR_LKP_BankAccount__c)), AXF_CTR_LKP_BankAccount__r.AXF_BA_MD_Holder__c &lt;&gt; AXF_CTR_MD_Holder__c)</errorConditionFormula>
    <errorDisplayField>AXF_CTR_LKP_BankAccount__c</errorDisplayField>
    <errorMessage
  >The bank account must belong to the same holder as the contract.</errorMessage>
</ValidationRule>
