<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AXF_CTR_VR_CreditCardSameHolder</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(AXF_CTR_LKP_CreditCard__c)), AXF_CTR_LKP_CreditCard__r.AXF_CC_MD_Holder__c &lt;&gt; AXF_CTR_MD_Holder__c)</errorConditionFormula>
    <errorDisplayField>AXF_CTR_LKP_CreditCard__c</errorDisplayField>
    <errorMessage
  >The credit card must belong to the same holder as the contract.</errorMessage>
</ValidationRule>
