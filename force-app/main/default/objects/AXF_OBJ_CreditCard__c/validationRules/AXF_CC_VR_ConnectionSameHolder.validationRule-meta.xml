<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AXF_CC_VR_ConnectionSameHolder</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(AXF_CC_LKP_Connection__c)), AXF_CC_LKP_Connection__r.AXF_CON_MD_Holder__c &lt;&gt; AXF_CC_MD_Holder__c)</errorConditionFormula>
    <errorDisplayField>AXF_CC_LKP_Connection__c</errorDisplayField>
