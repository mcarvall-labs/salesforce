<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description
  >Parcela economica por pessoa/empresa (Account) de um rateio (AXF-126). Master-Detail do set (herda acesso); magnitude sempre positiva, moeda original, identidade canonica alloc-v2 unica por set+account. Rateio nao cria share implicito.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Parcela de Rateio Economico</label>
    <nameField>
        <displayFormat>EA-{000000}</displayFormat>
        <label>Numero da Parcela</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Parcelas de Rateio Economico</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
