<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AXF_BDG_VR_StartMonthFirstDay</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(AXF_BDG_DAT_StartMonth__c)), DAY(AXF_BDG_DAT_StartMonth__c) &lt;&gt; 1)</errorConditionFormula>
    <errorDisplayField>AXF_BDG_DAT_StartMonth__c</errorDisplayField>
    <errorMessage
  >The start month must be the first day of the month.</errorMessage>
</ValidationRule>
