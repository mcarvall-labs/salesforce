<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AXF_BDG_VR_EndAfterStart</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(NOT(ISBLANK(AXF_BDG_DAT_EndMonth__c)), NOT(ISBLANK(AXF_BDG_DAT_StartMonth__c)), AXF_BDG_DAT_EndMonth__c &lt; AXF_BDG_DAT_StartMonth__c)</errorConditionFormula>
    <errorDisplayField>AXF_BDG_DAT_EndMonth__c</errorDisplayField>
    <errorMessage>The end month cannot be before the start month.</errorMessage>
</ValidationRule>
