<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Identificador fiscal protegido de contraparte (AD-30, G1, G7). Contém apenas máscara e HMAC digest versionado. Valor reversível permanece expressamente proibido.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Identificador Fiscal de Contraparte</label>
    <nameField>
        <displayFormat>CTID-{000000}</displayFormat>
        <label>Número do Identificador Fiscal</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Identificadores Fiscais de Contraparte</pluralLabel>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
