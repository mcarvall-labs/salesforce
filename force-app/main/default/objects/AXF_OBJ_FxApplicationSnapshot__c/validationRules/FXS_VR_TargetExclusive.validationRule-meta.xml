<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FXS_VR_TargetExclusive</fullName>
    <active>true</active>
    <description
  >Exatamente um alvo coerente com TargetType (AXF-24).</description>
    <errorConditionFormula
  >OR(OR(AND(TEXT(AXF_FXS_PKL_TargetType__c) = &quot;FINANCIAL_TRANSACTION&quot;, OR(ISBLANK(AXF_FXS_LKP_FinancialTransaction__c), NOT(ISBLANK(AXF_FXS_LKP_FxSettlementCharge__c)))), AND(TEXT(AXF_FXS_PKL_TargetType__c) = &quot;FX_SETTLEMENT_CHARGE&quot;, OR(ISBLANK(AXF_FXS_LKP_FxSettlementCharge__c), NOT(ISBLANK(AXF_FXS_LKP_FinancialTransaction__c))))), AND(TEXT(AXF_FXS_PKL_TargetType__c) = &quot;RECONCILIATION_ALLOCATION&quot;, OR(ISBLANK(AXF_FXS_LKP_ReconciliationAllocation__c), NOT(ISBLANK(AXF_FXS_LKP_FinancialTransaction__c)), NOT(ISBLANK(AXF_FXS_LKP_FxSettlementCharge__c)))), AND(TEXT(AXF_FXS_PKL_TargetType__c) != &quot;RECONCILIATION_ALLOCATION&quot;, NOT(ISBLANK(AXF_FXS_LKP_ReconciliationAllocation__c))))</errorConditionFormula>
    <errorDisplayField>AXF_FXS_PKL_TargetType__c</errorDisplayField>
    <errorMessage
  >O snapshot deve apontar exatamente para o alvo coerente com o TargetType.</errorMessage>
</ValidationRule>
