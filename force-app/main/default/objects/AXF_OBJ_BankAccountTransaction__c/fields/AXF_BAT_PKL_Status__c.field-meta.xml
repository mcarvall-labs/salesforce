<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AXF_BAT_PKL_Status__c</fullName>
    <description
  >status da Pluggy no GET /v2/transactions. PENDING ainda pode mudar de valor/data ou desaparecer; somente POSTED e firme. A sincronizacao reimporta itens PENDING ate virarem POSTED.</description>
    <label>Situacao no Provedor</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>POSTED</fullName>
                <default>true</default>
                <label>Lancada</label>
            </value>
            <value>
                <fullName>PENDING</fullName>
                <default>false</default>
                <label>Pendente</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
