<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AXF_ENT_VR_PaymentDateRequired</fullName>
    <active>true</active>
    <errorConditionFormula
  >AND(TEXT(AXF_ENT_PKL_Status__c) = &apos;Realized&apos;, ISBLANK(AXF_ENT_DAT_PaymentDate__c))</errorConditionFormula>
    <errorDisplayField>AXF_ENT_DAT_PaymentDate__c</errorDisplayField>
    <errorMessage
  >The payment date is required when the status is Realized.</errorMessage>
</ValidationRule>
