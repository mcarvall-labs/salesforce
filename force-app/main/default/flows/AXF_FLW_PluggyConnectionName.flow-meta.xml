<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Set_Name</name>
        <label>Set Name</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NameFormula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description
  >Sets the connection Name to Holder name + institution code before save.</description>
    <environments>Default</environments>
    <formulas>
        <name>NameFormula</name>
        <dataType>String</dataType>
        <expression
    >LEFT({!$Record.AXF_CON_MD_Holder__r.Name} &amp; &quot; - &quot; &amp; TEXT({!$Record.AXF_CON_PKL_Institution__c}), 80)</expression>
    </formulas>
    <interviewLabel
  >AXF Pluggy Connection Name {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AXF Pluggy Connection Name</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Name</targetReference>
        </connector>
        <object>AXF_OBJ_PluggyConnection__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
