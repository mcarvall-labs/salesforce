<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Axon - Gestor Financeiro (componente)</label>
    <description>Componente do PSG AXF_PSG_GestorFinanceiro. Consultar, cadastrar e editar titulares (Account/Contact); sem Delete; sem ViewAll/ModifyAll. Concede AXF_CanConfigure e o acesso a configuracao de niveis. Perms do dominio vem por US. AXF-7.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <customPermissions>
        <enabled>true</enabled>
        <name>AXF_CanConfigure</name>
    </customPermissions>
    <classAccesses>
        <apexClass>AXF_CLS_CTRL_AccessLevelConfig</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
