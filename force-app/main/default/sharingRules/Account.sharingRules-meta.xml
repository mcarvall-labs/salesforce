<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>AXF_Account_FamiliaParaTodos</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <description>Account do Record Type Família (guarda as metas globais, EP-07) compartilhada em Leitura/Gravação com Axon - Gestor Financeiro e Axon - Participante. AXF-243.</description>
        <label>AXF Account - Família para todos</label>
        <sharedTo>
            <roleAndSubordinates>Axon_Gestor_Financeiro</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>RecordType</field>
            <operation>equals</operation>
            <value>Família</value>
        </criteriaItems>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>AXF_Account_GestorParaGestor</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <description>Registros de Account cujo owner tem o papel Axon - Gestor Financeiro sao compartilhados em Leitura/Gravacao com o mesmo papel (sem subordinados). AXF-7 / G2.</description>
        <label>AXF Account - Gestor para Gestor</label>
        <sharedTo>
            <role>Axon_Gestor_Financeiro</role>
        </sharedTo>
        <sharedFrom>
            <role>Axon_Gestor_Financeiro</role>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
